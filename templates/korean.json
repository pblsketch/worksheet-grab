{
  "id": "korean-template",
  "subject": "korean",
  "dataSubject": "ko",
  "theme": "neutral",
  "lang": "ko",
  "head": { "katex": false },
  "pillDefault": "독서·토론",
  "runHeadTemplate": "2022 개정 교육과정 · {subjectLabel} · 활동지",
  "runFootTemplate": { "left": "2022 개정 교육과정 연계 {subjectLabel} 활동지", "rightPrefix": "{topic}" },
  "slots": {
    "DIRECTIVE": "다음 글을 읽고, 질문에 답하며 생각을 정리하고 친구들과 토론해 보자.",
    "REF": "{subjectLabel}",
    "UNIT": "{topic}",
    "PASSAGE": "［지문 삽입 슬롯］ 저작권 보호 대상 지문은 교사가 원문을 이 영역에 붙여 넣습니다.",
    "Q1": "글쓴이가 말하고자 하는 핵심 주장은 무엇인가요?",
    "A1": "［교사 예시 답안 슬롯］",
    "TOPIC_STMT": "［논제 슬롯］ 이 단원의 토론 논제를 교사가 입력합니다.",
    "REFLECT": "토론 후 생각이 어떻게 바뀌었는지, 나만의 원칙 3가지를 정리해 보자.",
    "RUBRIC1": "글의 핵심 내용을 파악하여 설명할 수 있는가?",
    "RUBRIC2": "근거를 들어 자신의 입장을 밝힐 수 있는가?",
    "RUBRIC3": "다른 관점을 존중하며 토론에 참여할 수 있는가?"
  },
  "pages": [
    [
      { "type": "header", "html": "<div class=\"wsheet-title-wrap\">\n    <span class=\"pill\">{{PILL}}</span>\n    <span class=\"corner-ref\">{{REF}}</span>\n    <div class=\"title-box\"><h1>{{TITLE}}</h1></div>\n    <div class=\"unit-line\">\n      <div class=\"unit\"><b>단원</b>　{{UNIT}}</div>\n      <div class=\"namefield\">학년<span></span> 반<span></span> 이름<span></span></div>\n    </div>\n  </div>" },
      { "type": "standard-label", "gen": "standard-label" },
      { "type": "directive", "html": "<div class=\"direct\">{{DIRECTIVE}}</div>" },
      { "type": "passage", "html": "<div class=\"passage keep\">\n    <h3>{{TITLE}}</h3>\n    <div class=\"slot\">{{PASSAGE}}</div>\n  </div>" },
      { "type": "subq", "html": "<p class=\"subq\"><span class=\"qnum\">1</span>다음 질문에 답하며 글의 내용을 이해해 보자.</p>" },
      { "type": "question", "html": "<div class=\"q\">(1) {{Q1}}</div>" },
      { "type": "content", "html": "<div class=\"answer\">{{A1}}</div>" },
      { "type": "answer-line", "html": "<div class=\"ans-line\"></div><div class=\"ans-line\"></div>" }
    ],
    [
      { "type": "subq", "html": "<p class=\"subq\"><span class=\"qnum\">2</span>다음 논제에 대해 찬반 논거를 준비해 보자.</p>" },
      { "type": "emphasis-box", "html": "<div class=\"dash-box\" style=\"border-style:solid;border-color:#cbd5c0;\">\n    <div class=\"db\" style=\"min-height:0;padding:8px 12px;text-align:center;font-weight:600;\">{{TOPIC_STMT}}</div>\n  </div>" },
      { "type": "pro-con", "html": "<table class=\"pc\">\n    <tr><th class=\"pro\">찬성</th><th class=\"con\">반대</th></tr>\n    <tr><td><span class=\"rc\">＊이유:</span><div class=\"dv\"></div><span class=\"rc\">＊근거:</span></td><td><span class=\"rc\">＊이유:</span><div class=\"dv\"></div><span class=\"rc\">＊근거:</span></td></tr>\n    <tr><td><span class=\"rc\">＊이유:</span><div class=\"dv\"></div><span class=\"rc\">＊근거:</span></td><td><span class=\"rc\">＊이유:</span><div class=\"dv\"></div><span class=\"rc\">＊근거:</span></td></tr>\n  </table>" },
      { "type": "reflection", "html": "<div class=\"q\">{{REFLECT}}</div>\n  <div class=\"princ\"><div class=\"dot\"></div><div class=\"dot\"></div><div class=\"dot\"></div></div>" },
      { "type": "section-heading", "html": "<h2 class=\"sec\"><span class=\"n\">3</span>점검표를 작성하며 활동을 정리해 보자.</h2>" },
      { "type": "rubric", "html": "<table class=\"rubric\">\n    <tr><th>점검 요소</th><th style=\"width:22%\">점검 결과</th></tr>\n    <tr><td>{{RUBRIC1}}</td><td class=\"stars\">☆☆☆☆☆</td></tr>\n    <tr><td>{{RUBRIC2}}</td><td class=\"stars\">☆☆☆☆☆</td></tr>\n    <tr><td>{{RUBRIC3}}</td><td class=\"stars\">☆☆☆☆☆</td></tr>\n  </table>" }
    ]
  ]
}
